	keywords = {Computer Science - Cryptography and Security},
	file = {PDF:C\:\\Users\\13577\\Zotero\\storage\\5XNEHPY2\\Wang 等 - 2023 - A Survey on Metaverse Fundamentals, Security, and Privacy.pdf:application/pdf},
